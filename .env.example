# Sanity (shared with crows-are-white-studio)
NUXT_SANITY_PROJECT_ID=11cdscj2
NUXT_SANITY_DATASET=production

# Sanity write token — create at sanity.io/manage with Editor permissions (for UGC uploads)
SANITY_WRITE_TOKEN=

# Shopify mock mode — use fixtures until store credentials exist
NUXT_MOCK_SHOPIFY=true

# Shopify — create a dev store, then a custom app with Storefront API access
# https://admin.shopify.com → Settings → Apps → Develop apps
NUXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NUXT_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NUXT_SHOPIFY_STOREFRONT_TOKEN=shpat_your_storefront_token

# Shopify webhook signing secret (Orders paid → UGC follow-up email)
SHOPIFY_WEBHOOK_SECRET=

# Resend — also used for contact form and post-purchase UGC follow-up
RESEND_API_KEY=
CONTACT_FORM_FROM_EMAIL="Crows Are White <hello@crowsarewhite.com>"

# Public site URL (used in follow-up email links)
NUXT_SITE_URL=https://crowsarewhite.com

# Hosting — deploy Nuxt to Vercel (vercel.json included) or Netlify
# Studio — cd ../crows-are-white-studio && npx sanity deploy
